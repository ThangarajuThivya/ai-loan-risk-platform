PORT=5000
NODE_ENV=development

# REQUIRED. Three INDEPENDENT random values — never reuse one across the
# three, and never invent a memorable phrase. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (or: openssl rand -hex 32). See README.md -> "Configuring finance-backend/.env".
# Changing one later logs every user out and invalidates pending reset links.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
RESET_TOKEN_SECRET=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_loan

# Python ML risk-model service (FastAPI). The Node gateway is the only caller;
# the browser never talks to it directly. No trailing slash.
MODEL_URL=http://localhost:8000

# Python currency-forecast service (FastAPI, currency-forecast-model/). Same
# pattern as MODEL_URL — the Node gateway is the only caller. No trailing slash.
CURRENCY_MODEL_URL=http://localhost:8100

# Live FX rate feed (Phase 7) — a SEPARATE data plane from CURRENCY_MODEL_URL
# above; see ARCHITECTURE.md §8.1 (the two data planes). Free,
# no API key: open.er-api.com (backed by exchangerate-api.com's free tier).
# Leave blank to use the default. Rewrite to a different provider only if you
# also update src/services/rateFeed.service.js's response-shape parsing.
CURRENCY_RATE_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
# How often to poll the provider, in ms. Default 3600000 (1h) — the provider
# itself only updates once every ~24h, so this is a safety margin, not an
# attempt to catch every change.
CURRENCY_RATE_FEED_INTERVAL_MS=3600000

# FX exchange-request quoting — see ARCHITECTURE.md §9.6.
# Signs the short-TTL quote token POST /api/currency/exchange/quote returns.
# Leave blank to fall back to ACCESS_TOKEN_SECRET; set it explicitly only if
# quote tokens should be rotated independently of login access tokens.
FX_QUOTE_SECRET=
# How long a locked quote is valid for, in seconds. Default 900 (15 min) —
# the bank only bears rate-movement risk for this window; a submission after
# expiry is refused outright rather than silently extended.
FX_QUOTE_TTL_SECONDS=900
# A live rate-board snapshot older than this refuses to quote at all, in ms.
# Default 21600000 (6h) — matches the /board endpoint's own staleness flag.
FX_QUOTE_MAX_BOARD_AGE_MS=21600000
# How long a submitted request may sit in 'pending_review' before the
# background sweep (src/services/fxExpirySweep.service.js) auto-expires it,
# in ms. Default 259200000 (3 days) — real staff review isn't instant, so
# this is a much longer window than the quote TTL above, not the same thing.
FX_REQUEST_REVIEW_SLA_MS=259200000

# Gemini (Google AI Studio) — natural-language risk explanations. The key is
# held server-side only (ARCHITECTURE.md §10); the browser never sees it. Leave
# GEMINI_API_KEY blank in local dev — assess still succeeds with a deterministic
# fallback explanation. Get a free key at aistudio.google.com/app/apikey.
# GEMINI_MODEL: a free "flash" model. gemini-flash-latest always points at the
# current free flash model; gemini-2.5-flash-lite also works on the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Forgot-password OTP emails. Leave blank in local dev — the OTP is logged to
# the server console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
