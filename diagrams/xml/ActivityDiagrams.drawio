<diagram id="page1" name="1. Loan Credit-Decision Algorithm"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2150" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a2" value="Activity Diagram -- Loan Credit-Decision Algorithm (ARCHITECTURE.md Sec 9.1.1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="2090" height="30" as="geometry"/></mxCell><mxCell id="a3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="988.0" y="48.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="a4" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="72" as="sourcePoint"/><mxPoint x="1000" y="112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a5" value="Receive application + KYC data + Gemini-extracted&#10;financials + CRIB score" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="112.5" width="560" height="55" as="geometry"/></mxCell><mxCell id="a6" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="168" as="sourcePoint"/><mxPoint x="1000" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a7" value="Evaluate the 12 credit-policy gating rules&#10;(batch check, single rule-engine call)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="720.0" y="220.0" width="560" height="60" as="geometry"/></mxCell><mxCell id="a8" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1280" y="250" as="sourcePoint"/><mxPoint x="1650" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a9" value="Gating rules (Sec 9.1.1):&#10;AGE_MIN, AGE_AT_MATURITY,&#10;MIN_MONTHLY_INCOME, NET_INCOME_POSITIVE,&#10;DTI_LIMIT, RESIDUAL_INCOME, LOAN_TO_INCOME,&#10;EMPLOYMENT_TENURE, EXISTING_FACILITIES,&#10;PREVIOUS_DEFAULTS, CRIB_SCORE,&#10;GUARANTOR_DEFAULTS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffbcc;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1650" y="170" width="380" height="150" as="geometry"/></mxCell><mxCell id="a10" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="280" as="sourcePoint"/><mxPoint x="1000" y="325" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a11" value="Any gating rule&#10;failed (hard fail)?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840.0" y="325.0" width="320" height="110" as="geometry"/></mxCell><mxCell id="a12" value="[yes]" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="380" as="sourcePoint"/><mxPoint x="1330" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a13" value="Reject: record the failed&#10;gating rule(s) as the reason" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330.0" y="350.0" width="380" height="60" as="geometry"/></mxCell><mxCell id="a14" value="[no]" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="435" as="sourcePoint"/><mxPoint x="1000" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a15" value="Invoke the loan-risk ML model --&#10;compute probability-of-default score" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="760.0" y="490.0" width="480" height="60" as="geometry"/></mxCell><mxCell id="a16" value="" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="550" as="sourcePoint"/><mxPoint x="1000" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a17" value="Risk score band?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="840.0" y="600.0" width="320" height="120" as="geometry"/></mxCell><mxCell id="a18" value="[low risk]" style="endArrow=block;endFill=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="660" as="sourcePoint"/><mxPoint x="530" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a19" value="Auto-approve: assign tier,&#10;rate &amp; credit limit" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=mid