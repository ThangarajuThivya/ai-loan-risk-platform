l id="c23" value="create a Checkout session for that exact amount" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="320" as="sourcePoint"/><mxPoint x="660" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="session URL" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="380" as="sourcePoint"/><mxPoint x="380" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="redirect to Stripe&#x27;s hosted payment page" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="440" as="sourcePoint"/><mxPoint x="100" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="pays with card (card details never reach this system)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="500" as="sourcePoint"/><mxPoint x="660" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="570" as="sourcePoint"/><mxPoint x="1330" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="— confirmation arrives via one of two concurrent paths —" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="520.0" y="552" width="320" height="16" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;fontSize=1;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="1040" height="590" as="geometry"/></mxCell><mxCell id="c30" value="par" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;size=8;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="43" height="22" as="geometry"/></mxCell><mxCell id="c31" value="[webhook path]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="101" y="600" width="981" height="22" as="geometry"/></mxCell><mxCell id="c32" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="900" as="sourcePoint"/><mxPoint x="1090" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="[return-page path — also works with no webhook configured at all]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="58" y="902" width="1024" height="20" as="geometry"/></mxCell><mxCell id="c34" value="webhook: checkout.session.completed (signed)" style="endArrow=open;endFill=0;dashed=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="650" as="sourcePoint"/><mxPoint x="380" y="650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="verify the webhook signature (STRIPE_WEBHOOK_SECRET)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="700" as="sourcePoint"/><mxPoint x="385" y="735" as="targetPoint"/><Array as="points"><mxPoint x="475" y="700"/><mxPoint x="475" y="735"/></Array></mxGeometry></mxCell><mxCell id="c36" value="settle the payment-intent EXACTLY ONCE (settleWithin — locked&#10;gate + DB uniqueness constraint); post to the repayment ledger" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="790" as="sourcePoint"/><mxPoint x="940" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="notification: payment received / loan fully repaid" style="endArrow=open;endFill=0;dashed=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="850" as="sourcePoint"/><mxPoint x="100" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="(in parallel) return-page polls the payment-intent&#x27;s status" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="950" as="sourcePoint"/><mxPoint x="380" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="if still unsettled, ask Stripe directly what happened" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1010" as="sourcePoint"/><mxPoint x="660" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="settle through the SAME idempotent gate, if not already settled" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1065" as="sourcePoint"/><mxPoint x="940" y="1065" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="confirmed once settled, either way" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1130" as="sourcePoint"/><mxPoint x="100" y="1130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1330" width="560" height="24" as="geometry"/></mxCell><mxCell id="c43" value="-&gt; solid line, filled arrowhead : synchronous call&amp;#10;-&gt; dashed line, open arrowhead   : return / reply&amp;#10;-&gt; solid line, open arrowhead    : asynchronous (fire-and-forget)&amp;#10;loop-back arrow on a lifeline       : self-message (internal step)&amp;#10;thin rectangle on a lifeline        : activation (object is processing)&amp;#10;dashed pentagon-tab box &#x27;par&#x27;       : concurrent operands, same outcome" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="1354" width="560" height="106" as="geometry"/></mxCell><mxCell id="c44" value="Source" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1470" width="560" height="24" as="geometry"/></mxCell><mxCell id="c45" value="ARCHITECTURE.md §9.15 — redrawn from the section&#x27;s own mermaid&amp;#10;sequenceDiagram. Card data never reaches this system (§11); the&amp;#10;&#x27;settle exactly once&#x27; gate is keyed on the Stripe session id so&amp;#10;either arrival path — or both — posts the payment at most once." style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="1494" width="560" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>