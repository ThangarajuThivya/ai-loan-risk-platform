ounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="935" y="435" width="10" height="70" as="geometry"/></mxCell><mxCell id="c26" value="POST /loans/:id/documents (file: NIC / payslip / bank statement / CR copy)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="140" as="sourcePoint"/><mxPoint x="380" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="store file under non-public secure-uploads/;&#10;insert document row (verification_status = pending)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="200" as="sourcePoint"/><mxPoint x="660" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="201 Created — response sent immediately" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="260" as="sourcePoint"/><mxPoint x="100" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="315" as="sourcePoint"/><mxPoint x="1330" y="315" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="— OCR/extraction pipeline runs in the BACKGROUND, after the response (§9.11.1) —" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="520.0" y="297" width="320" height="16" as="geometry"/></mxCell><mxCell id="c31" value="trigger documentPipeline.service.js (fire-and-forget;&#10;never blocks or fails the upload)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="350" as="sourcePoint"/><mxPoint x="385" y="385" as="targetPoint"/><Array as="points"><mxPoint x="475" y="350"/><mxPoint x="475" y="385"/></Array></mxGeometry></mxCell><mxCell id="c32" value="recognizeDocument() — born-digital PDF read directly (pdf-parse);&#10;scanned PDF/image sent to Gemini Vision, zero-shot" style="endArrow=open;endFill=0;dashed=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="440" as="sourcePoint"/><mxPoint x="940" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="raw transcribed text" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="500" as="sourcePoint"/><mxPoint x="380" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="documentExtraction.service.js — rule-based, label-anchored&#10;field extraction (pure, no I/O)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="550" as="sourcePoint"/><mxPoint x="385" y="585" as="targetPoint"/><Array as="points"><mxPoint x="475" y="550"/><mxPoint x="475" y="585"/></Array></mxGeometry></mxCell><mxCell id="c35" value="documentValidation.service.js — rule-based cross-document validation" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="630" as="sourcePoint"/><mxPoint x="385" y="665" as="targetPoint"/><Array as="points"><mxPoint x="475" y="630"/><mxPoint x="475" y="665"/></Array></mxGeometry></mxCell><mxCell id="c36" value="insert document_extractions row&#10;(ADVISORY ONLY — never writes verification_status)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="720" as="sourcePoint"/><mxPoint x="660" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="775" as="sourcePoint"/><mxPoint x="1330" y="775" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="— staff reviews the document —" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="520.0" y="757" width="320" height="16" as="geometry"/></mxCell><mxCell id="c39" value="GET /loans/:id/documents/:docId  (staff/admin, or the owning customer)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="810" as="sourcePoint"/><mxPoint x="380" y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="fetch the document + its advisory extraction/validation result" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="870" as="sourcePoint"/><mxPoint x="660" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="document + extraction advisory (never a decision, just context)" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="930" as="sourcePoint"/><mxPoint x="1220" y="930" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="PATCH /documents/:docId/verify { status: verified | rejected, note }" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="990" as="sourcePoint"/><mxPoint x="380" y="990" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="set verification_status (reviewer, timestamp, note)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1050" as="sourcePoint"/><mxPoint x="660" y="1050" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="{ status }" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1110" as="sourcePoint"/><mxPoint x="1220" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="notification: document verified / rejected" style="endArrow=open;endFill=0;dashed=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1170" as="sourcePoint"/><mxPoint x="100" y="1170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="1225" as="sourcePoint"/><mxPoint x="1330" y="1225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="— separately: customer KYC (national ID) follows the same review pattern —" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="520.0" y="1207" width="320" height="16" as="geometry"/></mxCell><mxCell id="c48" value="PATCH /profile { national_id }" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="1260" as="sourcePoint"/><mxPoint x="380" y="1260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="kyc_status -&gt; pending" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1320" as="sourcePoint"/><mxPoint x="660" y="1320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="PATCH /admin/customers/:id/kyc { status: verified | rejected, note }" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="1380" as="sourcePoint"/><mxPoint x="380" y="1380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="set kyc_status (reviewer, timestamp, note); once verified the NIC is&#10;LOCKED — a further customer change re-opens review, never silently overwrites" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1440" as="sourcePoint"/><mxPoint x="660" y="1440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="{ status }" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1500" as="sourcePoint"/><mxPoint x="1220" y="1500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1600" width="620" height="24" as="geometry"/></mxCell><mxCell id="c54" value="-&gt; solid line, filled arrowhead : synchronous call&amp;#10;-&gt; dashed line, open arrowhead   : return / reply&amp;#10;-&gt; solid line, open arrowhead    : asynchronous (fire-and-forget)&amp;#10;loop-back arrow on a lifeline       : self-message (internal step)&amp;#10;thin rectangle on a lifeline        : activation (object is processing)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="1624" width="620" height="90" as="geometry"/></mxCell><mxCell id="c55" value="Source" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1724" width="620" height="24" as="geometry"/></mxCell><mxCell id="c56" value="ARCHITECTURE.md §9.11 (two advisory-only verification trails: loan&amp;#10;documents and customer KYC) and §9.11.1&#x27;s own flowchart (OCR&amp;#10;recognition -&gt; rule-based extraction -&gt; rule-based validation -&gt;&amp;#10;advisory row that NEVER writes verification_status itself)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="1748" width="620" height="78" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>