)" style="endArrow=open;endFill=0;dashed=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1670" as="sourcePoint"/><mxPoint x="100" y="1670" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1800" width="560" height="24" as="geometry"/></mxCell><mxCell id="c63" value="→ solid line, filled arrowhead : synchronous call&amp;#10;→ dashed line, open arrowhead   : return / reply&amp;#10;→ solid line, open arrowhead    : asynchronous (fire-and-forget)&amp;#10;loop-back arrow on a lifeline      : self-message (internal step)&amp;#10;thin rectangle on a lifeline       : activation (object is processing)&amp;#10;dashed pentagon-tab box &#x27;opt&#x27;      : optional block (guard condition)&amp;#10;dashed pentagon-tab box &#x27;alt&#x27;      : mutually exclusive branches" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1824" width="560" height="122" as="geometry"/></mxCell><mxCell id="c64" value="Source" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1956" width="560" height="24" as="geometry"/></mxCell><mxCell id="c65" value="ARCHITECTURE.md §9.6 (quote/submit/review/settle + state machine),&amp;#10;§9.7 (document threshold gate — 409 if required docs missing),&amp;#10;§9.9 (inventory reserve-on-approve / release-on-non-settled-terminal).&amp;#10;cancel (customer) and the background expiry sweep are covered on&amp;#10;the FX State Machine diagram, not repeated here." style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1980" width="560" height="94" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>