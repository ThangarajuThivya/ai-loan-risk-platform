id="c23" value="commit — application status, offer, and account move together" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="320" as="sourcePoint"/><mxPoint x="665" y="355" as="targetPoint"/><Array as="points"><mxPoint x="755" y="320"/><mxPoint x="755" y="355"/></Array></mxGeometry></mxCell><mxCell id="c24" value="{ status: &quot;accepted&quot;, disbursement_account }" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="410" as="sourcePoint"/><mxPoint x="100" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="notification: &quot;we opened/are using account …&quot;" style="endArrow=open;endFill=0;dashed=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="470" as="sourcePoint"/><mxPoint x="100" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="545" as="sourcePoint"/><mxPoint x="1160" y="545" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="— time elapses; staff/admin later process the disbursement —" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="440.0" y="527" width="320" height="16" as="geometry"/></mxCell><mxCell id="c28" value="PATCH /api/loans/:id/disburse  (staff/admin only)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="610" as="sourcePoint"/><mxPoint x="660" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="copy account, interest rate, tenure, EMI from the ACCEPTED&#10;offer — never recomputed, never the applicant&#x27;s original ask" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="670" as="sourcePoint"/><mxPoint x="940" y="670" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="insert loan_accounts row (beneficiary account details&#10;snapshotted at this instant)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="730" as="sourcePoint"/><mxPoint x="940" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="generate the full repayment_schedule from these exact&#10;terms (same transaction, §9.14)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="790" as="sourcePoint"/><mxPoint x="940" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="update loan_applications.status = disbursed;&#10;append loan_application_events row (§9.10)" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="850" as="sourcePoint"/><mxPoint x="940" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="{ status: &quot;disbursed&quot;, loan_account }" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;fontColor=#333333;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="910" as="sourcePoint"/><mxPoint x="380" y="910" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="notification + email: &quot;your loan has been disbursed&quot;" style="endArrow=open;endFill=0;dashed=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#666666;fontColor=#666666;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="970" as="sourcePoint"/><mxPoint x="100" y="970" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="520" height="24" as="geometry"/></mxCell><mxCell id="c36" value="→ solid line, filled arrowhead : synchronous call&amp;#10;→ dashed line, open arrowhead   : return / reply&amp;#10;→ solid line, open arrowhead    : asynchronous (fire-and-forget)&amp;#10;loop-back arrow on a lifeline      : self-message (internal step)&amp;#10;thin rectangle on a lifeline       : activation (object is processing)&amp;#10;dashed horizontal divider           : elapsed time / separate request" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1114" width="520" height="106" as="geometry"/></mxCell><mxCell id="c37" value="Source" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="520" height="24" as="geometry"/></mxCell><mxCell id="c38" value="ARCHITECTURE.md §9.13 (offer acceptance + account resolution,&amp;#10;redrawn from its own mermaid sequenceDiagram), §9.10 (status&amp;#10;transitions + append-only loan_application_events), and §9.14&amp;#10;(repayment schedule generated at disbursement).&amp;#10;No approved -&gt; disbursed edge exists (§9.10): only an explicit&amp;#10;customer accept can move an application past &#x27;approved&#x27;." style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1254" width="520" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>