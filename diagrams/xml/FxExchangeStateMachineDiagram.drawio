<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0" type="device">
  <diagram name="FX Exchange Request State Machine" id="fx-request-sm">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="FX Exchange Request Lifecycle — UML State Machine Diagram" style="text;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- Initial pseudostate -->
        <mxCell id="init1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="155" y="40" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Spine states -->
        <mxCell id="pending_review" value="pending_review" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ready_for_settlement" value="ready_for_settlement" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="settled" value="settled" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Side (terminal) states -->
        <mxCell id="rejected" value="rejected" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cancelled" value="cancelled" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="expired" value="expired" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="350" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Final pseudostate -->
        <mxCell id="final_outer" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="155" y="630" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="final_inner" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="161" y="636" width="18" height="18" as="geometry" />
        </mxCell>

        <!-- ===== Transitions ===== -->

        <mxCell id="e_init" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#333333;" edge="1" parent="1" source="init1" target="pending_review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- pending_review -> ready_for_settlement -->
        <mxCell id="e1" value="review: approve&#10;[documents complete; stock sufficient]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pending_review" target="ready_for_settlement">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ready_for_settlement -> settled -->
        <mxCell id="e2" value="settle (physically at branch)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ready_for_settlement" target="settled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- pending_review -> rejected (same row) -->
        <mxCell id="e3" value="review: reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pending_review" target="rejected">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- pending_review -> cancelled -->
        <mxCell id="e4" value="cancel (customer only)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=1;exitY=0.67;entryX=0;entryY=0.5;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pending_review" target="cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="150" />
              <mxPoint x="330" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- pending_review -> expired -->
        <mxCell id="e5" value="background sweep past review SLA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;dashed=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;strokeColor=#d79b00;fontColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pending_review" target="expired">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="158" />
              <mxPoint x="350" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- pending_review self-loop: counter -->
        <mxCell id="e_loop" value="review: counter&#10;(revised terms, same status)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=0;exitY=0.25;entryX=0;entryY=0.75;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;align=right;" edge="1" parent="1" source="pending_review" target="pending_review">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="125" />
              <mxPoint x="20" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- settled -> final -->
        <mxCell id="e_final_settled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#333333;" edge="1" parent="1" source="settled" target="final_outer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- rejected -> final -->
        <mxCell id="e_final_rej" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;entryX=1;entryY=0.15;" edge="1" parent="1" source="rejected" target="final_outer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="170" />
              <mxPoint x="800" y="170" />
              <mxPoint x="800" y="634" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- cancelled -> final -->
        <mxCell id="e_final_cxl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;entryX=1;entryY=0.45;" edge="1" parent="1" source="cancelled" target="final_outer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="290" />
              <mxPoint x="830" y="290" />
              <mxPoint x="830" y="643" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- expired -> final -->
        <mxCell id="e_final_exp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;entryX=1;entryY=0.75;" edge="1" parent="1" source="expired" target="final_outer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="410" />
              <mxPoint x="860" y="410" />
              <mxPoint x="860" y="652" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== Legend ===== -->
        <mxCell id="legend" value="Notation&#10;&#8226; Filled circle = initial pseudostate (start)&#10;&#8226; Circle-in-circle = final pseudostate (end)&#10;&#8226; Rounded rectangle = state&#10;&#8226; Solid arrow, label = trigger / role&#10;&#8226; Bracketed text = guard condition (must hold for the transition to fire)&#10;&#8226; Dashed grey arrow = terminal path to the final state&#10;&#8226; Self-loop = counter-offer keeps the request in pending_review&#10;&#10;Colour key: blue = awaiting review &#183; green = positive progression &#183; red = rejected &#183; grey = cancelled &#183; amber = expired (system timeout)" style="text;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;whiteSpace=wrap;html=0;rounded=1;fillColor=#f5f5f5;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="440" height="220" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Source: ARCHITECTURE.md &#167;9.6/&#167;9.7/&#167;9.9. Every transition is validated server-side (an illegal one, e.g. settling a rejected request, returns 409, never 500) and writes an audit-trail row plus a notification. The approve gate also requires sufficient reserved bank-wide FX inventory (&#167;9.9), released back automatically if the request later ends in rejected/cancelled/expired." style="text;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fontStyle=2;whiteSpace=wrap;html=0;" vertex="1" parent="1">
          <mxGeometry x="520" y="700" width="400" height="180" as="geometry" />
        </mxCell>

